+static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* base) {
+  // Local addition (AO2DC): the 64 bytes around r31 (often the object the call came through).
+  if (base && ctx.r31.u32 >= 0x10000) {
+    std::string words;
+    for (int i = -4; i < 12; ++i) {
+      uint32_t addr = ctx.r31.u32 + i * 4;
+      uint32_t host = addr + (addr >= 0xE0000000u ? 0x1000u : 0u);
+      uint32_t v = *reinterpret_cast<uint32_t*>(base + host);
+      words += fmt::format(" {:08X}", __builtin_bswap32(v));
+    }
+    REXLOG_ERROR("Invalid call: memory at r31-16:{}", words);
+  }
+  // Local addition (AO2DC): the caller's return address and argument registers, to find the
+  // call site.
+  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X} (lr 0x{:08X}, "
+            "r3 0x{:08X} r4 0x{:08X} r1 0x{:08X} r31 0x{:08X})",
+            ctx.last_indirect_target, uint32_t(ctx.lr), ctx.r3.u32, ctx.r4.u32, ctx.r1.u32, ctx.r31.u32);
 }
 

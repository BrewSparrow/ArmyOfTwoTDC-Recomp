+// Local change (AO2DC): memexport readback writes back only the dwords the draw changed. The
+// ranges come from stream constants and can be far larger than what the shader writes - in Army of
+// Two: The Devil's Cartel a 384 KB range covers the job system's live task pool - and the GPU's copy
+// of untouched parts can be out of date, so copying whole ranges back reverts CPU writes. The
+// ranges are copied into the first half of a readback buffer before the draw (IssueDraw) and into
+// the second half after it; dwords that differ are the draw's writes.
+//
+// Waiting for the GPU after every memexporting draw stalled the game (GPU particles on every
+// shot), so the copies are queued and merged once their submission has completed - at the latest
+// before the command processor makes anything visible to the guest that could depend on them (a
+// memory write, an event write, a WAIT_REG_MEM on memory, a swap). Only used on the command
+// processor thread.
+namespace {
+struct MemexportReadback {
+  ID3D12Resource* buffer = nullptr;
+  uint32_t buffer_size = 0;
+  uint32_t total_size = 0;
+  std::vector<draw_util::MemExportRange> ranges;
+  uint64_t submission = 0;
+};
+thread_local MemexportReadback memexport_current_;  // pre-draw copy made, post-draw copy pending
+thread_local std::deque<MemexportReadback> memexport_pending_;
+thread_local std::vector<std::pair<ID3D12Resource*, uint32_t>> memexport_free_buffers_;
+}  // namespace
+
+static void MergeMemexportReadback(memory::Memory* memory,
+                                   const std::vector<draw_util::MemExportRange>& ranges,
+                                   const uint8_t* before_bytes, const uint8_t* after_bytes) {
+  const auto* before = reinterpret_cast<const uint32_t*>(before_bytes);
+  const auto* after = reinterpret_cast<const uint32_t*>(after_bytes);
+  for (const draw_util::MemExportRange& range : ranges) {
+    auto* guest =
+        reinterpret_cast<uint32_t*>(memory->TranslatePhysical(range.base_address_dwords << 2));
+    uint32_t dwords = range.size_bytes / 4;
+    uint64_t changed = 0;
+    for (uint32_t i = 0; i < dwords; ++i) {
+      if (!before || after[i] != before[i]) {
+        guest[i] = after[i];
+        ++changed;
+      }
+    }
+    if (REXCVAR_GET(ao2dc_log_memexport)) {
+      auto& entry = ao2dc_perf_.memexports[{range.base_address_dwords << 2, range.size_bytes}];
+      ++entry.first;
+      entry.second += changed;
+    }
+    after += dwords;
+    if (before) {
+      before += dwords;
+    }
+  }
+}
+
+void D3D12CommandProcessor::CopyMemexportRangesBeforeDraw() {
+  if (memexport_current_.buffer) {
+    // A previous draw's copy was never completed; recycle its buffer.
+    memexport_free_buffers_.emplace_back(memexport_current_.buffer, memexport_current_.buffer_size);
+    memexport_current_ = MemexportReadback();
+  }
+  if (memexport_ranges_.empty() ||
+      !IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport))) {
+    return;
+  }
+  uint32_t total_size = 0;
+  for (const draw_util::MemExportRange& range : memexport_ranges_) {
+    total_size += range.size_bytes;
+  }
+  if (!total_size) {
+    return;
+  }
+  uint32_t needed = rex::align(total_size * 2, uint32_t(64 * 1024));
+  ID3D12Resource* buffer = nullptr;
+  uint32_t buffer_size = 0;
+  for (size_t i = 0; i < memexport_free_buffers_.size(); ++i) {
+    if (memexport_free_buffers_[i].second >= needed) {
+      buffer = memexport_free_buffers_[i].first;
+      buffer_size = memexport_free_buffers_[i].second;
+      memexport_free_buffers_.erase(memexport_free_buffers_.begin() + i);
+      break;
+    }
+  }
+  if (!buffer) {
+    const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, needed, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(provider.GetDevice()->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&buffer)))) {
+      return;
+    }
+    buffer_size = needed;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t offset = 0;
+  for (const draw_util::MemExportRange& range : memexport_ranges_) {
+    deferred_command_list_.D3DCopyBufferRegion(buffer, offset, shared_memory_buffer,
+                                               range.base_address_dwords << 2, range.size_bytes);
+    offset += range.size_bytes;
+  }
+  memexport_current_.buffer = buffer;
+  memexport_current_.buffer_size = buffer_size;
+  memexport_current_.total_size = total_size;
+  memexport_current_.ranges = memexport_ranges_;
+}
+
+bool D3D12CommandProcessor::QueueMemexportReadback(uint32_t total_size) {
+  if (!memexport_current_.buffer || memexport_current_.total_size != total_size) {
+    return false;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t offset = total_size;
+  for (const draw_util::MemExportRange& range : memexport_current_.ranges) {
+    deferred_command_list_.D3DCopyBufferRegion(memexport_current_.buffer, offset,
+                                               shared_memory_buffer,
+                                               range.base_address_dwords << 2, range.size_bytes);
+    offset += range.size_bytes;
+  }
+  memexport_current_.submission = submission_current_;
+  ++ao2dc_perf_.memexport_queued;
+  ao2dc_perf_.memexport_bytes += total_size;
+  memexport_pending_.push_back(std::move(memexport_current_));
+  memexport_current_ = MemexportReadback();
+  return true;
+}
+
+void D3D12CommandProcessor::ApplyMemexportReadbacks(bool await) {
+  if (memexport_pending_.empty()) {
+    return;
+  }
+  if (await) {
+    bool stalled = memexport_pending_.back().submission > submission_completed_;
+    auto stall_start = std::chrono::steady_clock::now();
+    AwaitAllQueueOperationsCompletion();
+    if (stalled) {
+      ++ao2dc_perf_.memexport_flush_stalls;
+      uint64_t us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                 std::chrono::steady_clock::now() - stall_start)
+                                 .count());
+      ao2dc_perf_.stall_us += us;
+      ao2dc_perf_.max_stall_us = std::max(ao2dc_perf_.max_stall_us, us);
+    }
+  } else {
+    CheckSubmissionFence(0);
+  }
+  while (!memexport_pending_.empty() &&
+         memexport_pending_.front().submission <= submission_completed_) {
+    MemexportReadback& readback = memexport_pending_.front();
+    D3D12_RANGE read_range = {0, SIZE_T(readback.total_size) * 2};
+    void* mapping = nullptr;
+    if (SUCCEEDED(readback.buffer->Map(0, &read_range, &mapping))) {
+      const auto* bytes = static_cast<const uint8_t*>(mapping);
+      MergeMemexportReadback(memory_, readback.ranges, bytes, bytes + readback.total_size);
+      D3D12_RANGE write_range = {};
+      readback.buffer->Unmap(0, &write_range);
+    }
+    memexport_free_buffers_.emplace_back(readback.buffer, readback.buffer_size);
+    memexport_pending_.pop_front();
+  }
+}
+
+void D3D12CommandProcessor::FlushGuestMemoryWrites() {
+  ApplyMemexportReadbacks(true);
+}

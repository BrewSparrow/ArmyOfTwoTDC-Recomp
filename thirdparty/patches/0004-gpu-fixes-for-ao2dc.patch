+// Local change (AO2DC): Army of Two: The Devil's Cartel renders its screen-space ambient
+// occlusion into an 8888 target, resolves it to a k_8 texture (640x352), blurs it as a k_8_8_8_8
+// texture of a quarter of the width over the same memory, and samples the k_8 result. Under
+// emulation the result comes out as flat horizontal stripes, which darken the scene in bands. With
+// ao2dc_disable_ssao, the blurred AO is replaced by 0xFF (no occlusion) right after each such blur
+// resolve, before anything samples it.
+namespace {
+struct Ao2dcSsaoTarget {
+  uint32_t address = 0;
+  uint32_t pitch = 0;
+  uint32_t height = 0;
+};
+thread_local Ao2dcSsaoTarget ao2dc_ssao_target_;
+}  // namespace
+
+static void Ao2dcSuppressSsao(RegisterFile& regs, memory::Memory& memory,
+                              SharedMemory& shared_memory, uint32_t written_address,
+                              uint32_t written_length) {
+  if (!REXCVAR_GET(ao2dc_disable_ssao) || !written_length) {
+    return;
+  }
+  auto dest_info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  auto dest_pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  uint32_t dest_base = regs[XE_GPU_REG_RB_COPY_DEST_BASE];
+  uint32_t format = uint32_t(dest_info.copy_dest_format);
+  uint32_t pitch = dest_pitch.copy_dest_pitch;
+  uint32_t height = dest_pitch.copy_dest_height;
+  if (format == uint32_t(xenos::TextureFormat::k_8)) {
+    // Candidate AO texture; remember it.
+    ao2dc_ssao_target_ = {dest_base, pitch, height};
+    return;
+  }
+  if (format != uint32_t(xenos::TextureFormat::k_8_8_8_8) || !ao2dc_ssao_target_.pitch ||
+      dest_base != ao2dc_ssao_target_.address || pitch * 4 != ao2dc_ssao_target_.pitch ||
+      height != ao2dc_ssao_target_.height) {
+    return;
+  }
+  // A blur pass wrote the packed AO: make it "no occlusion" in guest memory and have the GPU
+  // reload it (and textures over it) from there.
+  uint8_t* host = memory.TranslatePhysical(written_address);
+  if (!host) {
+    return;
+  }
+  std::memset(host, 0xFF, written_length);
+  shared_memory.MemoryInvalidationCallback(written_address, written_length, true);
+  static bool logged = false;
+  if (!logged) {
+    logged = true;
+    REXGPU_INFO("SSAO disabled: AO buffer at 0x{:08X} ({}x{} k_8) replaced with no occlusion",
+                dest_base, ao2dc_ssao_target_.pitch, height);
+  }
+}
+
+REXCVAR_DEFINE_BOOL(ao2dc_tiles_full_range, false, "GPU",
+                    "AO2DC diagnostic: overwrite the 40x22 min/max depth-tile table with the full "
+                    "depth range after each resolve (tests the tiled-lighting explosion blocks)");
+
+// AO2DC diagnostics: the game reduces depth to a 40x22 k_32_32_FLOAT table (32 px tiles of the
+// 1280x704 scene; resolved twice a frame) that its tiled lighting uses to cull lights per tile.
+// With ao2dc_tiles_full_range every tile gets the full range (far 0.0, near 1.0 - reversed
+// depth), so no light is culled by tile depth.
+namespace {
+struct Ao2dcTilesPending {
+  uint32_t address = 0, length = 0, dest_info = 0, dest_pitch = 0, dest_base = 0;
+};
+thread_local Ao2dcTilesPending ao2dc_tiles_pending_;
+}  // namespace
+
+static void Ao2dcTilesFullRangeAt(memory::Memory& memory, SharedMemory& shared_memory,
+                                  const Ao2dcTilesPending& r) {
+  if (!REXCVAR_GET(ao2dc_tiles_full_range) || !r.length) {
+    return;
+  }
+  reg::RB_COPY_DEST_INFO dest_info;
+  dest_info.value = r.dest_info;
+  reg::RB_COPY_DEST_PITCH dest_pitch;
+  dest_pitch.value = r.dest_pitch;
+  const uint32_t written_address = r.address, written_length = r.length;
+  if (uint32_t(dest_info.copy_dest_format) != uint32_t(xenos::TextureFormat::k_32_32_FLOAT) ||
+      dest_pitch.copy_dest_pitch > 64 || dest_pitch.copy_dest_height > 32) {
+    return;
+  }
+  uint8_t* host = memory.TranslatePhysical(written_address);
+  if (!host) {
+    return;
+  }
+  static const uint8_t kTexel[8] = {0x00, 0x00, 0x00, 0x00, 0x3F, 0x80, 0x00, 0x00};
+  for (uint32_t i = 0; i + 8 <= written_length; i += 8) {
+    std::memcpy(host + i, kTexel, 8);
+  }
+  shared_memory.MemoryInvalidationCallback(written_address, written_length, true);
+  static bool logged = false;
+  if (!logged) {
+    logged = true;
+    REXGPU_INFO("Depth tiles at 0x{:08X} ({}x{} k_32_32_FLOAT) set to the full range",
+                r.dest_base, uint32_t(dest_pitch.copy_dest_pitch),
+                uint32_t(dest_pitch.copy_dest_height));
+  }
+}
+
+REXCVAR_DEFINE_STRING(ao2dc_resolve_fill, "", "GPU",
+                      "AO2DC diagnostic: after each resolve matching \"pitch,height,format,byte\" "
+                      "(destination pitch and height in texels, xenos texture format number, fill "
+                      "byte 0-255), overwrite the written memory with the byte. Empty = off. "
+                      "Example: 96,48,6,0 (the 80x48 k_8_8_8_8 tile mask)");
+
+// AO2DC diagnostics: overwrite one kind of small resolve with a constant, to find which
+// intermediate buffer the explosion blocks come from. Checked live (no restart needed).
+static void Ao2dcResolveFillAt(memory::Memory& memory, SharedMemory& shared_memory,
+                               const Ao2dcTilesPending& r) {
+  const std::string& spec = REXCVAR_GET(ao2dc_resolve_fill);
+  if (spec.empty() || !r.length) {
+    return;
+  }
+  unsigned pitch = 0, height = 0, format = 0, byte = 0;
+  if (std::sscanf(spec.c_str(), "%u,%u,%u,%u", &pitch, &height, &format, &byte) != 4) {
+    return;
+  }
+  reg::RB_COPY_DEST_INFO dest_info;
+  dest_info.value = r.dest_info;
+  reg::RB_COPY_DEST_PITCH dest_pitch;
+  dest_pitch.value = r.dest_pitch;
+  if (uint32_t(dest_info.copy_dest_format) != format ||
+      uint32_t(dest_pitch.copy_dest_pitch) != pitch ||
+      uint32_t(dest_pitch.copy_dest_height) != height) {
+    return;
+  }
+  uint8_t* host = memory.TranslatePhysical(r.address);
+  if (!host) {
+    return;
+  }
+  std::memset(host, int(byte & 0xFF), r.length);
+  shared_memory.MemoryInvalidationCallback(r.address, r.length, true);
+  static std::string logged_spec;
+  if (logged_spec != spec) {
+    logged_spec = spec;
+    REXGPU_INFO("Resolve fill: {}x{} format {} at 0x{:08X} (+{}) set to 0x{:02X}", pitch, height,
+                format, r.dest_base, r.length, byte & 0xFF);
+  }
+}
+
+static void Ao2dcTilesFullRange(RegisterFile& regs, memory::Memory& memory,
+                                SharedMemory& shared_memory, uint32_t written_address,
+                                uint32_t written_length) {
+  const Ao2dcTilesPending pending{written_address, written_length,
+                                  regs.Get<reg::RB_COPY_DEST_INFO>().value,
+                                  regs.Get<reg::RB_COPY_DEST_PITCH>().value,
+                                  regs[XE_GPU_REG_RB_COPY_DEST_BASE]};
+  Ao2dcTilesFullRangeAt(memory, shared_memory, pending);
+  Ao2dcResolveFillAt(memory, shared_memory, pending);
+}
+
+REXCVAR_DEFINE_INT32(ao2dc_log_small_resolves, 0, "GPU",
+                     "AO2DC diagnostic: log the next N resolves whose destination is at most "
+                     "64x64 (format, address, size, written range, source). 0 = off");

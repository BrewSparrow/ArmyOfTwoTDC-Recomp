+              regs[XE_GPU_REG_RB_COPY_DEST_BASE], uint32_t(dest_pitch.copy_dest_pitch),
+              uint32_t(dest_pitch.copy_dest_height), written_address, written_length,
+              uint32_t(control.copy_src_select), uint32_t(control.copy_sample_select),
+              uint32_t(dest_info.copy_dest_endian), uint32_t(dest_info.copy_dest_slice),

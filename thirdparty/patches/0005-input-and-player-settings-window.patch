+
 void SettingsDialog::OnDraw(ImGuiIO& /*io*/) {
   auto& registry = rex::cvar::GetRegistry();
+  Ao2Theme theme;
+
+  auto find_entry = [&](const char* name) -> decltype(&*registry.begin()) {
+    for (auto& entry : registry) {
+      if (entry.name == name) {
+        return &entry;
+      }
+    }
+    return nullptr;
+  };
+  auto get = [&](const char* name) -> std::string {
+    auto* entry = find_entry(name);
+    return entry ? entry->getter() : std::string();
+  };
+  auto set = [&](const char* name, const std::string& value) {
+    rex::cvar::SetFlagByName(name, value);
+  };
+
+  if (!g_ao2_show_advanced) {
+    ImGui::SetNextWindowSize(ImVec2(600, 560), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("ARMY OF TWO: THE DEVIL'S CARTEL  |  SETTINGS##ao2", nullptr,
+                      ImGuiWindowFlags_NoCollapse)) {
+      ImGui::End();
+      return;
+    }
+    ImGui::TextColored(kAo2TextDim, "F4 closes this menu.  * applies after restarting the game.");
+
+    if (ImGui::BeginTabBar("##ao2tabs")) {
+      if (ImGui::BeginTabItem("  CONTROLS  ")) {
+        ImGui::BeginChild("##controls", ImVec2(0, -40.0f), false);
+        Ao2SectionHeader("MOUSE");
+        float sensitivity = float(std::atof(get("mnk_sensitivity").c_str()));
+        ImGui::Text("Mouse sensitivity");
+        ImGui::SameLine(220.0f);
+        ImGui::SetNextItemWidth(260.0f);
+        if (ImGui::SliderFloat("##sens", &sensitivity, 0.1f, 5.0f, "%.2f")) {
+          set("mnk_sensitivity", std::to_string(sensitivity));
+        }
+        bool invert = get("mnk_invert_y") == "true";
+        ImGui::Text("Invert vertical look");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##invert", &invert)) {
+          set("mnk_invert_y", invert ? "true" : "false");
+        }
+        bool mouse_look = get("mnk_mouse") == "true";
+        ImGui::Text("Mouse look");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##mouselook", &mouse_look)) {
+          set("mnk_mouse", mouse_look ? "true" : "false");
+        }
+
+        Ao2SectionHeader("KEY BINDINGS");
+        ImGui::TextColored(kAo2TextDim,
+                           "Click Rebind, then press a key or mouse button (Esc cancels).");
+        if (ImGui::BeginTable("##binds", 3,
+                              ImGuiTableFlags_RowBg | ImGuiTableFlags_SizingFixedFit)) {
+          ImGui::TableSetupColumn("Action", ImGuiTableColumnFlags_WidthFixed, 200.0f);
+          ImGui::TableSetupColumn("Key", ImGuiTableColumnFlags_WidthFixed, 160.0f);
+          ImGui::TableSetupColumn("##buttons", ImGuiTableColumnFlags_WidthStretch);
+          for (const Ao2Bind& bind : kAo2Binds) {
+            auto* entry = find_entry(bind.cvar);
+            if (!entry) {
+              continue;
+            }
+            ImGui::PushID(bind.cvar);
+            ImGui::TableNextRow();
+            ImGui::TableNextColumn();
+            ImGui::AlignTextToFramePadding();
+            ImGui::Text("%s", bind.label);
+            ImGui::TableNextColumn();
+            std::string current = entry->getter();
+            bool capturing = capturing_bind_name_ == entry->name;
+            if (capturing) {
+              ImGui::TextColored(kAo2OrangeHot, "Press a key...");
+              if (ImGui::IsKeyPressed(ImGuiKey_Escape)) {
+                capturing_bind_name_.clear();
+              } else {
+                for (int k = ImGuiKey_NamedKey_BEGIN; k < ImGuiKey_NamedKey_END; ++k) {
+                  auto imgui_key = static_cast<ImGuiKey>(k);
+                  if (imgui_key == ImGuiKey_Escape || imgui_key == ImGuiKey_F4 ||
+                      (imgui_key >= ImGuiKey_MouseLeft && imgui_key <= ImGuiKey_MouseWheelY)) {
+                    continue;
+                  }
+                  if (ImGui::IsKeyPressed(imgui_key)) {
+                    std::string name = rex::ui::VirtualKeyToString(ImGuiKeyToVirtualKey(imgui_key));
+                    if (!name.empty()) {
+                      rex::cvar::SetFlagByName(entry->name, name);
+                    }
+                    capturing_bind_name_.clear();
+                    break;
+                  }
+                }
+                // Ignore the click that started the capture.
+                if (!capturing_bind_name_.empty() && !ImGui::IsItemHovered()) {
+                  for (int mb = 0; mb < 3; ++mb) {
+                    if (ImGui::IsMouseClicked(mb) && capture_armed_) {
+                      const char* names[] = {"LMB", "RMB", "MMB"};
+                      rex::cvar::SetFlagByName(entry->name, names[mb]);
+                      capturing_bind_name_.clear();
+                      break;
+                    }
+                  }
+                }
+                capture_armed_ = true;
+              }
+            } else {
+              ImGui::AlignTextToFramePadding();
+              ImGui::Text("%s", current.empty() ? "-" : current.c_str());
+            }
+            ImGui::TableNextColumn();
+            if (!capturing) {
+              if (ImGui::SmallButton("Rebind")) {
+                capturing_bind_name_ = entry->name;
+                capture_armed_ = false;
+              }
+              ImGui::SameLine();
+              if (ImGui::SmallButton("Default")) {
+                rex::cvar::SetFlagByName(entry->name, entry->default_value);
+              }
+            }
+            // Same key on another action.
+            if (!current.empty()) {
+              for (const Ao2Bind& other : kAo2Binds) {
+                if (other.cvar != bind.cvar && get(other.cvar) == current) {
+                  ImGui::SameLine();
+                  ImGui::TextColored(kAo2OrangeHot, "(!)");
+                  if (ImGui::IsItemHovered()) {
+                    ImGui::SetTooltip("Also used for: %s", other.label);
+                  }
+                  break;
+                }
+              }
+            }
+            ImGui::PopID();
+          }
+          ImGui::EndTable();
+        }
+        ImGui::EndChild();
+        ImGui::EndTabItem();
+      }
+
+      if (ImGui::BeginTabItem("  DISPLAY  ")) {
+        ImGui::BeginChild("##display", ImVec2(0, -40.0f), false);
+        Ao2SectionHeader("SCREEN");
+        bool fullscreen = get("fullscreen") == "true";
+        ImGui::Text("Fullscreen *");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##fullscreen", &fullscreen)) {
+          set("fullscreen", fullscreen ? "true" : "false");
+        }
+        bool vsync = get("vsync") == "true";
+        ImGui::Text("V-Sync");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##vsync", &vsync)) {
+          set("vsync", vsync ? "true" : "false");
+        }
+        bool letterbox = get("present_letterbox") == "true";
+        ImGui::Text("Keep 16:9 aspect ratio");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##letterbox", &letterbox)) {
+          set("present_letterbox", letterbox ? "true" : "false");
+        }
+
+        Ao2SectionHeader("IMAGE QUALITY");
+        struct Choice {
+          const char* value;
+          const char* label;
+        };
+        static const Choice kEffects[] = {
+            {"bilinear", "Standard"}, {"cas", "Sharpen (AMD CAS)"}, {"fsr", "Upscale (AMD FSR)"}};
+        std::string effect = get("present_effect");
+        const char* effect_label = kEffects[0].label;
+        for (const Choice& c : kEffects) {
+          if (effect == c.value) {
+            effect_label = c.label;
+          }
+        }
+        ImGui::Text("Image filter *");
+        ImGui::SameLine(220.0f);
+        ImGui::SetNextItemWidth(260.0f);
+        if (ImGui::BeginCombo("##effect", effect_label)) {
+          for (const Choice& c : kEffects) {
+            if (ImGui::Selectable(c.label, effect == c.value)) {
+              set("present_effect", c.value);
+            }
+          }
+          ImGui::EndCombo();
+        }
+        static const Choice kAniso[] = {{"-1", "Game default"}, {"2", "2x"}, {"3", "4x"},
+                                        {"4", "8x"},           {"5", "16x"}};
+        std::string aniso = get("anisotropic_override");
+        const char* aniso_label = "Custom";
+        for (const Choice& c : kAniso) {
+          if (aniso == c.value) {
+            aniso_label = c.label;
+          }
+        }
+        ImGui::Text("Texture filtering");
+        ImGui::SameLine(220.0f);
+        ImGui::SetNextItemWidth(260.0f);
+        if (ImGui::BeginCombo("##aniso", aniso_label)) {
+          for (const Choice& c : kAniso) {
+            if (ImGui::Selectable(c.label, aniso == c.value)) {
+              set("anisotropic_override", c.value);
+            }
+          }
+          ImGui::EndCombo();
+        }
+        ImGui::EndChild();
+        ImGui::EndTabItem();
+      }
+
+      if (ImGui::BeginTabItem("  AUDIO  ")) {
+        ImGui::BeginChild("##audio", ImVec2(0, -40.0f), false);
+        Ao2SectionHeader("SOUND");
+        bool mute = get("audio_mute") == "true";
+        ImGui::Text("Mute all sound");
+        ImGui::SameLine(220.0f);
+        if (ImGui::Checkbox("##mute", &mute)) {
+          set("audio_mute", mute ? "true" : "false");
+        }
+        ImGui::TextColored(kAo2TextDim,
+                           "Music, effects and dialogue volume are in the game's own Options menu.");
+        ImGui::EndChild();
+        ImGui::EndTabItem();
+      }
+      ImGui::EndTabBar();
+    }
+
+    ImGui::Separator();

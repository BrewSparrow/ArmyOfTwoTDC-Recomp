+FpsCounterDialog::FpsCounterDialog(ImGuiDrawer* imgui_drawer) : ImGuiDialog(imgui_drawer) {
+  window_start_ = std::chrono::steady_clock::now();
+  window_start_frames_ = GetGuestFrameCount();
+}
+
+FpsCounterDialog::~FpsCounterDialog() {}
+
+void FpsCounterDialog::OnDraw(ImGuiIO& io) {
+  // Average over half-second windows so the number is readable.
+  auto now = std::chrono::steady_clock::now();
+  uint64_t frames = GetGuestFrameCount();
+  double elapsed = std::chrono::duration<double>(now - window_start_).count();
+  if (elapsed >= 0.5) {
+    uint64_t delta = frames - window_start_frames_;
+    fps_ = double(delta) / elapsed;
+    frame_ms_ = delta ? elapsed * 1000.0 / double(delta) : 0.0;
+    have_value_ = true;
+    window_start_ = now;
+    window_start_frames_ = frames;
+  }
+
+  char text[64];
+  if (have_value_) {
+    snprintf(text, sizeof(text), "%.0f FPS  %.1f ms", fps_, frame_ms_);
+  } else {
+    snprintf(text, sizeof(text), "-- FPS");
+  }
+  ImVec4 color = fps_ >= 28.0 || !have_value_ ? ImVec4(0.55f, 1.0f, 0.55f, 1.0f)
+               : fps_ >= 20.0                 ? ImVec4(1.0f, 0.85f, 0.35f, 1.0f)
+                                              : ImVec4(1.0f, 0.45f, 0.40f, 1.0f);
+  float margin = 10.0f;
+  ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x - margin, margin), ImGuiCond_Always,
+                          ImVec2(1.0f, 0.0f));
+  ImGui::SetNextWindowBgAlpha(0.45f);
+  if (ImGui::Begin("##fps_counter", nullptr,
+                   ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs |
+                       ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoSavedSettings |
+                       ImGuiWindowFlags_NoFocusOnAppearing |
+                       ImGuiWindowFlags_AlwaysAutoResize)) {
+    ImGui::TextColored(color, "%s", text);
+  }
+  ImGui::End();
+}

+// Copies one frame into the ring. `swap` = source floats are big-endian.
+void Ao2dcRawPut(int which, const rex::audio::Ao2dcHostFrameHeader& header, const float* src,
+                 bool swap) {
+  Ao2dcRawRing& ring = ao2dc_raw_rings[which];
+  if (!ring.slots) {
+    return;
+  }
+  const uint32_t count = std::min(header.channels * header.samples, kAo2dcRawMaxFloats);
+  Ao2dcRawSlot& slot = ring.slots[ring.next.fetch_add(1) % kAo2dcRawSlots];
+  const uint64_t v = slot.version.load(std::memory_order_relaxed);
+  slot.version.store(v + 1, std::memory_order_release);
+  std::atomic_thread_fence(std::memory_order_release);
+  slot.header = header;
+  if (src) {
+    std::memcpy(slot.data, src, count * sizeof(float));
+    if (swap) {
+      for (uint32_t i = 0; i < count; ++i) {
+        slot.data[i] = rex::byte_swap(slot.data[i]);
+      }
+    }
+  } else {
+    std::memset(slot.data, 0, count * sizeof(float));
+  }
+  std::atomic_thread_fence(std::memory_order_release);
+  slot.version.store(v + 2, std::memory_order_release);
+}

+};
+struct Ao2dcXmaStream {
+  bool reset_since_last = true;
+  uint32_t buffer_ptr = 0, packets = 0, rate = 0, stereo = 0, loop_count = 0, loop_start = 0,
+           loop_end = 0, frames = 0, prev_ptr = 0, work_buffer_ptr = 0;
+  bool logged = false;
+};
+std::array<Ao2dcXmaStream, 512> ao2dc_xma_streams;
+std::mutex ao2dc_xma_events_lock;
+std::map<uint32_t, uint32_t> ao2dc_xma_starts;  // input buffer -> buffers started, per interval
+// Last half second of each context's decoded output (interleaved), for dumping suspicious sounds.
+struct Ao2dcXmaHistory {
+  std::vector<float> samples;  // interleaved, ring
+  size_t write = 0;
+  uint32_t channels = 1, rate = 48000;
+};
+std::array<Ao2dcXmaHistory, 512> ao2dc_xma_history;
+uint32_t ao2dc_xma_dumps = 0;
+std::array<Ao2dcXmaEvent, 4096> ao2dc_xma_events;
+size_t ao2dc_xma_events_next = 0;
+
+uint64_t Ao2dcNowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+struct Ao2dcFramePath {
+  uint32_t packet_index, packet_count, relative_offset, frame_size, frame_count, current_frame,
+      skip_count;
+  uint64_t frame_hash;  // FNV-1a of the exact bytes handed to the decoder
+};
+
+// Same input frame -> loudness seen. Real XMA decoding is deterministic per frame (apart from the
+// overlap with the previous frame), so a frame decoding both quiet and as loud noise means the
+// decoder carried wrong state into it.
+struct Ao2dcFrameSeen {
+  uint32_t count = 0;
+  float min_rms = 1e9f, max_rms = 0.0f;
+  uint32_t reported = 0;
+};
+std::map<uint64_t, Ao2dcFrameSeen> ao2dc_frames_seen;
+uint32_t ao2dc_frame_reports = 0;
+
+void Ao2dcXmaPeakCheck(uint32_t id, const rex::audio::XMA_CONTEXT_DATA* data,
+                       const float* const* channels, int samples, const Ao2dcFramePath& path) {
+  // Diagnostics only: off unless the audio recorder is on (ao2dc_audio_record).
+  if (!REXCVAR_GET(ao2dc_audio_record)) {
+    return;
+  }
+  float peak = 0.0f;
+  double sum = 0.0;
+  int n = 0;
+  for (int c = 0; c < (data->is_stereo ? 2 : 1); ++c) {
+    for (int i = 0; i < samples; ++i) {
+      peak = std::max(peak, std::fabs(channels[c][i]));
+      sum += double(channels[c][i]) * channels[c][i];
+      ++n;
+    }
+  }
+  float rms = float(std::sqrt(sum / std::max(n, 1)));
+  {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    if (ao2dc_frames_seen.size() > 500000) {
+      ao2dc_frames_seen.clear();
+    }
+    Ao2dcFrameSeen& f = ao2dc_frames_seen[path.frame_hash];
+    ++f.count;
+    f.min_rms = std::min(f.min_rms, rms);
+    f.max_rms = std::max(f.max_rms, rms);
+    if (f.count > 1 && f.max_rms > 0.25f && f.max_rms > 4.0f * f.min_rms + 0.02f &&
+        f.reported < 2 && ao2dc_frame_reports < 100) {
+      ++f.reported;
+      ++ao2dc_frame_reports;
+      REXAPU_INFO("XMA same frame, different output: ctx {} hash {:016X} seen {} rms {:.3f}..{:.3f} "
+                  "(this {:.3f}) frame {}/{} bit {} size {} stereo {} rate {} buffer_frame {}",
+                  id, path.frame_hash, f.count, f.min_rms, f.max_rms, rms, path.current_frame,
+                  path.frame_count, path.relative_offset, path.frame_size,
+                  uint32_t(data->is_stereo), uint32_t(data->sample_rate),
+                  id < ao2dc_xma_streams.size() ? ao2dc_xma_streams[id].frames + 1 : 0);
+    }
+  }
+  if (id < ao2dc_xma_streams.size()) {
+    Ao2dcXmaStream& st = ao2dc_xma_streams[id];
+    const uint32_t ptr = data->current_buffer ? data->input_buffer_1_ptr : data->input_buffer_0_ptr;
+    if (data->input_buffer_read_offset == 32) {
+      st.prev_ptr = st.buffer_ptr;
+      st.buffer_ptr = ptr;
+      st.work_buffer_ptr = data->work_buffer_ptr;
+      st.packets = data->current_buffer ? data->input_buffer_1_packet_count
+                                        : data->input_buffer_0_packet_count;
+      st.rate = data->sample_rate;
+      st.stereo = data->is_stereo;
+      st.loop_count = data->loop_count;
+      st.loop_start = data->loop_start;
+      st.loop_end = data->loop_end;
+      st.frames = 0;
+      st.logged = false;
+      std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+      ++ao2dc_xma_starts[ptr];
+    }
+    ++st.frames;
+    if (data->input_buffer_read_offset == 32 && st.frames == 1) {
+      st.reset_since_last = false;
+    }
+  }
+  if (id < ao2dc_xma_history.size()) {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    Ao2dcXmaHistory& h = ao2dc_xma_history[id];
+    const uint32_t ch = data->is_stereo ? 2 : 1;
+    const uint32_t rate = rex::audio::kIdToSampleRate[std::min<uint32_t>(data->sample_rate, 3)];
+    if (h.samples.empty() || h.channels != ch || h.rate != rate) {
+      // A different stream format on this context: start a fresh history so a dump is never a
+      // mix of mono and stereo samples.
+      h.samples.assign(96000, 0.0f);
+      h.write = 0;
+    }
+    h.channels = ch;
+    h.rate = rate;
+    for (int i = 0; i < samples; ++i) {
+      for (uint32_t c = 0; c < ch; ++c) {
+        h.samples[h.write] = channels[c][i];
+        h.write = (h.write + 1) % h.samples.size();
+      }
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    ao2dc_xma_events[ao2dc_xma_events_next++ % ao2dc_xma_events.size()] = {
+        Ao2dcNowMs(), id, peak, float(std::sqrt(sum / std::max(n, 1))),
+        uint32_t(data->input_buffer_read_offset)};
+  }
+  ++ao2dc_xma_frames;
+  uint32_t milli = uint32_t(std::min(peak, 1000.0f) * 1000.0f);
+  uint32_t prev = ao2dc_xma_peak_milli.load();
+  while (milli > prev && !ao2dc_xma_peak_milli.compare_exchange_weak(prev, milli)) {
+  }
+  if (peak >= 0.9f) {
+    ++ao2dc_xma_loud_frames;
+  }
+  uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count());
+  uint64_t last = ao2dc_xma_peak_log_ms.load();
+  if (now_ms - last >= 5000 && ao2dc_xma_peak_log_ms.compare_exchange_strong(last, now_ms) &&
+      last) {
+    REXAPU_INFO("XMA output: {} frames, {} at >= 0.9 of full scale, max peak {:.3f}",
+                ao2dc_xma_frames.exchange(0), ao2dc_xma_loud_frames.exchange(0),
+                ao2dc_xma_peak_milli.exchange(0) / 1000.0);
+    std::vector<std::pair<uint32_t, uint32_t>> starts;
+    {
+      std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+      for (const auto& [buffer, count] : ao2dc_xma_starts) {
+        starts.emplace_back(count, buffer);
+      }
+      ao2dc_xma_starts.clear();
+    }
+    std::sort(starts.rbegin(), starts.rend());
+    uint32_t total = 0;
+    for (const auto& [count, buffer] : starts) {
+      total += count;
+    }
+    std::string top;
+    for (size_t i = 0; i < starts.size() && i < 6; ++i) {
+      top += fmt::format(" 0x{:08X}x{}", starts[i].second, starts[i].first);
+    }
+    REXAPU_INFO("XMA starts: {} buffers started ({} distinct); most:{}", total, starts.size(), top);
+  }
+}

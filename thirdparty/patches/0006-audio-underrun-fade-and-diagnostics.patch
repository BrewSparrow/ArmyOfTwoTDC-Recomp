+namespace rex::audio {
+// AO2DC diagnostics: called by the audio driver when the game's mix reaches full scale. Lists
+// the XMA contexts that decoded in the preceding 300 ms with their loudest frame.
+// AO2DC diagnostics: write the last second of every context that decoded in the last 800 ms
+// (prefix + "ctx<id>.wav", 32-bit float).
+void Ao2dcXmaDumpActive(const std::string& prefix) {
+  std::vector<uint32_t> active;
+  {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    uint64_t now = Ao2dcNowMs();
+    std::set<uint32_t> seen;
+    for (const auto& e : ao2dc_xma_events) {
+      if (e.time_ms && now - e.time_ms <= 800 && e.rms > 0.01f) {
+        seen.insert(e.context);
+      }
+    }
+    active.assign(seen.begin(), seen.end());
+  }
+  for (uint32_t ctx : active) {
+    if (ctx >= ao2dc_xma_history.size()) {
+      continue;
+    }
+    std::vector<float> pcm;
+    uint32_t channels, rate;
+    {
+      std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+      const Ao2dcXmaHistory& h = ao2dc_xma_history[ctx];
+      if (h.samples.empty()) {
+        continue;
+      }
+      pcm.insert(pcm.end(), h.samples.begin() + h.write, h.samples.end());
+      pcm.insert(pcm.end(), h.samples.begin(), h.samples.begin() + h.write);
+      channels = h.channels;
+      rate = h.rate;
+    }
+    const uint32_t frames = uint32_t(pcm.size() / channels);
+    const std::string path = prefix + fmt::format("ctx{}.wav", ctx);
+    if (FILE* f = std::fopen(path.c_str(), "wb")) {
+      const uint32_t data_bytes = frames * channels * 4;
+      auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+      auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+      std::fwrite("RIFF", 1, 4, f);
+      w32(36 + data_bytes);
+      std::fwrite("WAVEfmt ", 1, 8, f);
+      w32(16);
+      w16(3);
+      w16(uint16_t(channels));
+      w32(rate);
+      w32(rate * channels * 4);
+      w16(uint16_t(channels * 4));
+      w16(32);
+      std::fwrite("data", 1, 4, f);
+      w32(data_bytes);
+      std::fwrite(pcm.data(), 4, size_t(frames) * channels, f);
+      std::fclose(f);
+    }
+  }
+  REXAPU_INFO("Burst capture: {} ({} voices)", prefix, active.size());
+}
+
+void Ao2dcXmaReportRecent(float mix_peak) {
+  struct Agg {
+    uint32_t frames = 0;
+    float peak = 0, rms = 0;
+    uint64_t first_ms = 0;
+    uint32_t first_offset = 0;
+  };
+  std::map<uint32_t, Agg> by_context;
+  uint64_t now = Ao2dcNowMs();
+  {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    for (const auto& e : ao2dc_xma_events) {
+      if (!e.time_ms || now - e.time_ms > 300) {
+        continue;
+      }
+      Agg& a = by_context[e.context];
+      if (!a.frames || e.time_ms < a.first_ms) {
+        a.first_ms = e.time_ms;
+        a.first_offset = e.read_offset;
+      }
+      ++a.frames;
+      a.peak = std::max(a.peak, e.peak);
+      a.rms = std::max(a.rms, e.rms);
+    }
+  }
+  // Dump the loudest recently started contexts' decoded audio (first 16 files).
+  for (const auto& [ctx, a] : by_context) {
+    if (a.rms < 0.4f || ao2dc_xma_dumps >= 48 || ctx >= ao2dc_xma_history.size()) {
+      continue;
+    }
+    std::vector<float> pcm;
+    uint32_t channels, rate;
+    {
+      std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+      const Ao2dcXmaHistory& h = ao2dc_xma_history[ctx];
+      if (h.samples.empty()) {
+        continue;
+      }
+      pcm.insert(pcm.end(), h.samples.begin() + h.write, h.samples.end());
+      pcm.insert(pcm.end(), h.samples.begin(), h.samples.begin() + h.write);
+      channels = h.channels;
+      rate = h.rate;
+    }
+    const uint32_t frames = uint32_t(pcm.size() / channels);
+    std::filesystem::create_directories("logs");
+    const std::string path = fmt::format("logs/xma_dump_{:02d}_ctx{}.wav", ao2dc_xma_dumps++, ctx);
+    if (FILE* f = std::fopen(path.c_str(), "wb")) {
+      const uint32_t data_bytes = frames * channels * 4;
+      auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+      auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+      std::fwrite("RIFF", 1, 4, f);
+      w32(36 + data_bytes);
+      std::fwrite("WAVEfmt ", 1, 8, f);
+      w32(16);
+      w16(3);
+      w16(uint16_t(channels));
+      w32(rate);
+      w32(rate * channels * 4);
+      w16(uint16_t(channels * 4));
+      w16(32);
+      std::fwrite("data", 1, 4, f);
+      w32(data_bytes);
+      std::fwrite(pcm.data(), 4, size_t(frames) * channels, f);
+      std::fclose(f);
+      REXAPU_INFO("XMA dump: {} (ctx {}, {} Hz, {} ch, rms {:.2f})", path, ctx, rate, channels,
+                  a.rms);
+    }
+  }
+  // Input buffer per context identifies the sound asset; the same buffer on several contexts
+  // means the same sound is playing more than once (marked "dup").
+  std::map<uint32_t, uint32_t> buffer_uses;
+  std::map<uint32_t, uint32_t> context_buffer;
+  {
+    std::lock_guard<std::mutex> lock(ao2dc_xma_events_lock);
+    for (const auto& [ctx, a] : by_context) {
+      uint32_t buffer = ctx < ao2dc_xma_streams.size() ? ao2dc_xma_streams[ctx].buffer_ptr : 0;
+      context_buffer[ctx] = buffer;
+      if (buffer) {
+        ++buffer_uses[buffer];
+      }
+    }
+  }
+  std::string list;
+  for (const auto& [ctx, a] : by_context) {
+    uint32_t buffer = context_buffer[ctx];
+    list += fmt::format(" [ctx {} buf {:08X}{} frames {} peak {:.2f} rms {:.2f} since -{}ms off {}]",
+                        ctx, buffer, buffer && buffer_uses[buffer] > 1 ? " dup" : "", a.frames,
+                        a.peak, a.rms, now - a.first_ms, a.first_offset);
+  }
+  REXAPU_INFO("Mix at full scale (peak {:.2f}); XMA in last 300 ms:{}", mix_peak, list);
+}

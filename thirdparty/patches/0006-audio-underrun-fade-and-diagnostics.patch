+namespace rex::audio {
+// AO2DC: host-side burst signals for the centre recorder's automatic trigger. Bit 0 counts
+// output frames with a sample-to-sample jump >= 0.5; bit 32 counts frames where the look-ahead
+// limiter starts turning the mix down. Read as two 32-bit counters packed in one atomic.
+std::atomic<uint64_t> ao2dc_host_events{0};
+uint64_t Ao2dcHostEventCount() {
+  return ao2dc_host_events.load(std::memory_order_relaxed);
+}
+uint64_t Ao2dcSubmitSeq() {
+  return ao2dc_submit_seq.load(std::memory_order_relaxed);
+}
+uint64_t Ao2dcPremixEventCount() {
+  return ao2dc_premix_events.load(std::memory_order_relaxed);
+}
+// Copies the frames of one ring (0 = premix, 1 = post-host) captured in [t0_ns, t1_ns] to `out`
+// as header + channels * samples raw floats each, oldest first. Returns the frame count.
+size_t Ao2dcCopyHostFrames(int which, uint64_t t0_ns, uint64_t t1_ns, std::vector<uint8_t>& out) {
+  if (which < 0 || which > 1 || !ao2dc_raw_rings[which].slots) {
+    return 0;
+  }
+  Ao2dcRawRing& ring = ao2dc_raw_rings[which];
+  struct Item {
+    uint64_t seq;
+    size_t offset;
+  };
+  std::vector<Item> items;
+  std::vector<uint8_t> staging;
+  std::vector<uint32_t> buffer(kAo2dcRawMaxFloats);
+  for (uint32_t i = 0; i < kAo2dcRawSlots; ++i) {
+    Ao2dcRawSlot& slot = ring.slots[i];
+    for (int attempt = 0; attempt < 4; ++attempt) {
+      const uint64_t v1 = slot.version.load(std::memory_order_acquire);
+      if (v1 == 0 || (v1 & 1)) {
+        continue;
+      }
+      Ao2dcHostFrameHeader header = slot.header;
+      std::memcpy(buffer.data(), slot.data, sizeof(slot.data));
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (slot.version.load(std::memory_order_acquire) != v1) {
+        continue;
+      }
+      if (header.t_ns >= t0_ns && header.t_ns <= t1_ns) {
+        const uint32_t count = std::min(header.channels * header.samples, kAo2dcRawMaxFloats);
+        items.push_back({header.seq, staging.size()});
+        const size_t at = staging.size();
+        staging.resize(at + sizeof(header) + count * sizeof(float));
+        std::memcpy(staging.data() + at, &header, sizeof(header));
+        std::memcpy(staging.data() + at + sizeof(header), buffer.data(), count * sizeof(float));
+      }
+      break;
+    }
+  }
+  std::sort(items.begin(), items.end(), [](const Item& a, const Item& b) { return a.seq < b.seq; });
+  for (const Item& item : items) {
+    const auto* header = reinterpret_cast<const Ao2dcHostFrameHeader*>(staging.data() + item.offset);
+    const size_t size = sizeof(*header) + size_t(header->channels) * header->samples * sizeof(float);
+    out.insert(out.end(), staging.begin() + item.offset, staging.begin() + item.offset + size);
+  }
+  return items.size();
+}

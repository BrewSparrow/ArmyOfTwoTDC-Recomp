+namespace rex::audio {
+struct Ao2dcHostFrameHeader {
+  uint64_t seq;        // premix: submit sequence; post-host: callback buffer sequence
+  uint64_t t_ns;       // steady_clock time of capture
+  uint64_t src_seq;    // post-host: premix sequence consumed (0 = silence/underrun)
+  uint32_t flags;      // 1 = underrun silence, 2 = first frame after underrun, 4 = non-finite
+  uint32_t channels;   // premix: 6 (sequential); post-host: device channels (interleaved)
+  uint32_t samples;    // per channel
+  uint32_t queue_depth;
+  float peak;          // largest |sample| (finite samples)
+  uint32_t nonfinite;  // count of non-finite samples

+namespace {
+// AO2DC diagnostics: rolling 6-channel 16-bit recording of the frames the game submits. The audio
+// callback only copies into the ring; a writer thread saves the newest 90 seconds periodically,
+// so the file always holds what was heard just before the game was closed.
+constexpr uint32_t kAo2dcRecordRate = 48000;
+constexpr uint32_t kAo2dcRecordFrames = kAo2dcRecordRate * 90;
+std::vector<int16_t> ao2dc_record_ring;

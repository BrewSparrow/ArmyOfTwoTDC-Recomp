+void Ao2dcWriteWav(const char* tmp_path, const char* path, const std::vector<int16_t>& ring,
+                   uint64_t total, uint32_t channels) {
+  uint32_t ring_frames = uint32_t(ring.size() / channels);
+  uint32_t frames = uint32_t(std::min<uint64_t>(total, ring_frames));
+  if (!frames) {
+    return;
+  }
+  FILE* f = std::fopen(tmp_path, "wb");
+  if (!f) {
+    return;
+  }
+  const uint32_t data_bytes = frames * channels * 2;
+  auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+  auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+  std::fwrite("RIFF", 1, 4, f);
+  w32(36 + data_bytes);
+  std::fwrite("WAVEfmt ", 1, 8, f);
+  w32(16);
+  w16(1);
+  w16(uint16_t(channels));
+  w32(kAo2dcRecordRate);
+  w32(kAo2dcRecordRate * channels * 2);
+  w16(uint16_t(channels * 2));
+  w16(16);
+  std::fwrite("data", 1, 4, f);
+  w32(data_bytes);
+  uint32_t start = uint32_t((total - frames) % ring_frames);
+  uint32_t first = std::min(frames, ring_frames - start);
+  std::fwrite(ring.data() + size_t(start) * channels, 2 * channels, first, f);
+  std::fwrite(ring.data(), 2 * channels, frames - first, f);
+  std::fclose(f);
+  std::error_code ec;
+  std::filesystem::rename(tmp_path, path, ec);
+}
+
+void Ao2dcRecordSave() {
+  if (!ao2dc_output_ring.empty()) {
+    Ao2dcWriteWav("logs/audio_output.tmp", "logs/audio_output.wav", ao2dc_output_ring,
+                  ao2dc_output_written.load(), ao2dc_output_channels.load());

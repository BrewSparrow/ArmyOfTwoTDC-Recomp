+namespace {
+// AO2DC diagnostics: rolling 6-channel 16-bit recording of the frames the game submits. The audio
+// callback only copies into the ring; a writer thread saves the newest 90 seconds periodically,
+// so the file always holds what was heard just before the game was closed.
+constexpr uint32_t kAo2dcRecordRate = 48000;
+constexpr uint32_t kAo2dcRecordFrames = kAo2dcRecordRate * 90;
+std::vector<int16_t> ao2dc_record_ring;
+// The stereo (or device-channel) signal actually handed to the device, after limiter and fold.
+std::vector<int16_t> ao2dc_output_ring;
+std::atomic<uint64_t> ao2dc_output_written{0};
+std::atomic<uint32_t> ao2dc_output_channels{2};
+std::atomic<uint64_t> ao2dc_record_written{0};  // total frames ever written
+std::thread ao2dc_record_thread;
+
+void Ao2dcWriteWav(const char* tmp_path, const char* path, const std::vector<int16_t>& ring,
+                   uint64_t total, uint32_t channels) {
+  uint32_t ring_frames = uint32_t(ring.size() / channels);
+  uint32_t frames = uint32_t(std::min<uint64_t>(total, ring_frames));
+  if (!frames) {
+    return;
+  }
+  FILE* f = std::fopen(tmp_path, "wb");
+  if (!f) {
+    return;
+  }
+  const uint32_t data_bytes = frames * channels * 2;
+  auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+  auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+  std::fwrite("RIFF", 1, 4, f);
+  w32(36 + data_bytes);
+  std::fwrite("WAVEfmt ", 1, 8, f);
+  w32(16);
+  w16(1);
+  w16(uint16_t(channels));
+  w32(kAo2dcRecordRate);
+  w32(kAo2dcRecordRate * channels * 2);
+  w16(uint16_t(channels * 2));
+  w16(16);
+  std::fwrite("data", 1, 4, f);
+  w32(data_bytes);
+  uint32_t start = uint32_t((total - frames) % ring_frames);
+  uint32_t first = std::min(frames, ring_frames - start);
+  std::fwrite(ring.data() + size_t(start) * channels, 2 * channels, first, f);
+  std::fwrite(ring.data(), 2 * channels, frames - first, f);
+  std::fclose(f);
+  std::error_code ec;
+  std::filesystem::rename(tmp_path, path, ec);
+}
+
+void Ao2dcRecordSave() {
+  if (!ao2dc_output_ring.empty()) {
+    Ao2dcWriteWav("logs/audio_output.tmp", "logs/audio_output.wav", ao2dc_output_ring,
+                  ao2dc_output_written.load(), ao2dc_output_channels.load());
+  }
+  uint64_t total = ao2dc_record_written.load();
+  uint32_t frames = uint32_t(std::min<uint64_t>(total, kAo2dcRecordFrames));
+  if (!frames) {
+    return;
+  }
+  std::filesystem::create_directories("logs");
+  FILE* f = std::fopen("logs/audio_record.tmp", "wb");
+  if (!f) {
+    return;
+  }
+  const uint32_t channels = 6, bits = 16;
+  const uint32_t data_bytes = frames * channels * (bits / 8);
+  auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+  auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+  std::fwrite("RIFF", 1, 4, f);
+  w32(36 + data_bytes);
+  std::fwrite("WAVEfmt ", 1, 8, f);
+  w32(16);
+  w16(1);  // PCM
+  w16(uint16_t(channels));
+  w32(kAo2dcRecordRate);
+  w32(kAo2dcRecordRate * channels * (bits / 8));
+  w16(uint16_t(channels * (bits / 8)));
+  w16(uint16_t(bits));
+  std::fwrite("data", 1, 4, f);
+  w32(data_bytes);
+  uint32_t start = uint32_t((total - frames) % kAo2dcRecordFrames);
+  uint32_t first = std::min(frames, kAo2dcRecordFrames - start);
+  std::fwrite(ao2dc_record_ring.data() + size_t(start) * 6, 12, first, f);
+  std::fwrite(ao2dc_record_ring.data(), 12, frames - first, f);
+  std::fclose(f);
+  std::error_code ec;
+  std::filesystem::rename("logs/audio_record.tmp", "logs/audio_record.wav", ec);
+  // Wall-clock time of the recordings' last sample, to line them up with a screen recording.
+  if (FILE* t = std::fopen("logs/audio_record_time.txt", "w")) {
+    auto now = std::chrono::system_clock::now();
+    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count();
+    std::time_t secs = std::time_t(ms / 1000);
+    std::tm local{};
+    localtime_s(&local, &secs);
+    std::fprintf(t,
+                 "audio_record.wav and audio_output.wav end at %04d-%02d-%02d %02d:%02d:%02d.%03d "
+                 "local time\nmix frames %llu, output frames %llu\n",
+                 local.tm_year + 1900, local.tm_mon + 1, local.tm_mday, local.tm_hour, local.tm_min,
+                 local.tm_sec, int(ms % 1000), (unsigned long long)total,
+                 (unsigned long long)ao2dc_output_written.load());
+    std::fclose(t);
+  }
+}
+
+void Ao2dcRecord(const float* sequential_be, size_t channel_samples) {
+  if (!REXCVAR_GET(ao2dc_audio_record)) {
+    return;
+  }
+  if (ao2dc_record_ring.empty()) {
+    ao2dc_record_ring.resize(size_t(kAo2dcRecordFrames) * 6);
+    ao2dc_record_thread = std::thread([] {
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        Ao2dcRecordSave();
+      }
+    });
+    ao2dc_record_thread.detach();
+  }
+  uint64_t total = ao2dc_record_written.load();
+  for (size_t i = 0; i < channel_samples; ++i) {
+    size_t slot = size_t((total + i) % kAo2dcRecordFrames) * 6;
+    for (size_t c = 0; c < 6; ++c) {
+      float v = rex::byte_swap(sequential_be[c * channel_samples + i]);
+      ao2dc_record_ring[slot + c] = int16_t(std::clamp(v, -1.0f, 1.0f) * 32767.0f);
+    }
+  }
+  ao2dc_record_written.store(total + channel_samples);
+}
+
+// Records the converted device signal (interleaved floats, device channel count).
+void Ao2dcRecordOutput(const float* interleaved, size_t frames, uint32_t channels) {
+  if (!REXCVAR_GET(ao2dc_audio_record) || ao2dc_record_ring.empty()) {
+    return;
+  }
+  if (ao2dc_output_ring.empty()) {
+    ao2dc_output_channels.store(channels);
+    ao2dc_output_ring.resize(size_t(kAo2dcRecordFrames) * channels);
+  }
+  const uint32_t ring_frames = uint32_t(ao2dc_output_ring.size() / channels);
+  uint64_t total = ao2dc_output_written.load();
+  for (size_t i = 0; i < frames; ++i) {
+    size_t slot = size_t((total + i) % ring_frames) * channels;
+    for (uint32_t c = 0; c < channels; ++c) {
+      ao2dc_output_ring[slot + c] =
+          int16_t(std::clamp(interleaved[i * channels + c], -1.0f, 1.0f) * 32767.0f);
+    }
+  }
+  ao2dc_output_written.store(total + frames);
+}
+
+// Last `frames` frames of the 6-channel mix ring as a 16-bit WAV.
+void Ao2dcSaveMixTail(const std::string& path, uint32_t frames) {
+  uint64_t total = ao2dc_record_written.load();
+  frames = uint32_t(std::min<uint64_t>({total, frames, kAo2dcRecordFrames}));
+  if (!frames || ao2dc_record_ring.empty()) {
+    return;
+  }
+  std::vector<int16_t> out(size_t(frames) * 6);
+  for (uint32_t i = 0; i < frames; ++i) {
+    size_t slot = size_t((total - frames + i) % kAo2dcRecordFrames) * 6;
+    std::copy_n(ao2dc_record_ring.data() + slot, 6, out.data() + size_t(i) * 6);
+  }
+  FILE* f = std::fopen(path.c_str(), "wb");
+  if (!f) {
+    return;
+  }
+  const uint32_t data_bytes = frames * 12;
+  auto w32 = [f](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+  auto w16 = [f](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+  std::fwrite("RIFF", 1, 4, f);
+  w32(36 + data_bytes);
+  std::fwrite("WAVEfmt ", 1, 8, f);
+  w32(16);
+  w16(1);
+  w16(6);
+  w32(kAo2dcRecordRate);
+  w32(kAo2dcRecordRate * 12);
+  w16(12);
+  w16(16);
+  std::fwrite("data", 1, 4, f);
+  w32(data_bytes);
+  std::fwrite(out.data(), 2, out.size(), f);
+  std::fclose(f);
+}
+
+// Peak of one guest frame (6 sequential big-endian channels) as it will reach the device.
+float Ao2dcFramePeak(const float* sequential_be, size_t channel_samples, int device_channels,
+                     const rex::audio::StereoFold& fold, float gain) {
+  auto at = [&](size_t c, size_t i) { return rex::byte_swap(sequential_be[c * channel_samples + i]); };
+  float peak = 0.0f;
+  for (size_t i = 0; i < channel_samples; ++i) {
+    if (device_channels == 2) {
+      const float mid = at(2, i) * fold.center + at(3, i) * fold.lfe;
+      peak = std::max(peak, std::fabs(at(0, i) + mid + at(4, i) * fold.surround));
+      peak = std::max(peak, std::fabs(at(1, i) + mid + at(5, i) * fold.surround));
+    } else {

+  std::atomic<uint64_t> version{0};  // odd while being written
+  rex::audio::Ao2dcHostFrameHeader header{};
+  uint32_t data[kAo2dcRawMaxFloats];  // raw float bits, little-endian order
+};
+struct Ao2dcRawRing {
+  Ao2dcRawSlot* slots = nullptr;
+  std::atomic<uint64_t> next{0};
+};
+Ao2dcRawRing ao2dc_raw_rings[2];  // 0 = premix, 1 = post-host
+std::atomic<uint64_t> ao2dc_submit_seq{0};

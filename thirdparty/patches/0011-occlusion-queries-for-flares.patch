+bool D3D12CommandProcessor::Ao2dcDumpEdram(const char* path) {
+  ID3D12Resource* edram = render_target_cache_ ? render_target_cache_->ao2dc_rov_edram_buffer() : nullptr;
+  if (!edram) return false;
+  const uint32_t size = uint32_t(edram->GetDesc().Width);
+  ID3D12Resource* readback = RequestReadbackBuffer(size);
+  if (!readback || !BeginSubmission(true)) return false;
+  render_target_cache_->Ao2dcTransitionEdramBuffer(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(readback, 0, edram, 0, size);
+  render_target_cache_->Ao2dcTransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  SubmitBarriers();
+  if (!AwaitAllQueueOperationsCompletion()) return false;
+  D3D12_RANGE range = {0, size};
+  void* mapped;
+  if (FAILED(readback->Map(0, &range, &mapped))) return false;
+  bool ok = false;
+  if (FILE* f = std::fopen(path, "wb")) {
+    ok = std::fwrite(mapped, 1, size, f) == size;
+    std::fclose(f);
+  }
+  D3D12_RANGE none = {};
+  readback->Unmap(0, &none);
+  return ok;
+}

+REXCVAR_DEFINE_BOOL(ao2dc_log_hd_io, false, "Game",
+                    "AO2DC diagnostic: log opens and nonzero reads of the HD archives (HD.sb, HD.toc) "
+                    "with the guest path and the host file behind it");
+
+namespace {
+bool IsHdArchive(std::string_view path) {
+  auto ends_with = [&](std::string_view suffix) {
+    if (path.size() < suffix.size())
+      return false;
+    for (size_t i = 0; i < suffix.size(); ++i)
+      if (std::tolower(static_cast<unsigned char>(path[path.size() - suffix.size() + i])) !=
+          suffix[i])
+        return false;
+    return true;
+  };
+  return ends_with("\hd.sb") || ends_with("\hd.toc") || ends_with("/hd.sb") ||
+         ends_with("/hd.toc") || ends_with(":hd.sb") || ends_with(":hd.toc");
+}
+
+// One line per HD archive for its first nonzero read, then a summary at most every 10 s.
+void LogHdRead(rex::filesystem::Entry* entry, uint64_t offset, uint32_t bytes) {
+  static std::mutex mutex;
+  struct Stat {
+    uint64_t reads = 0, bytes = 0;
+  };
+  static std::map<std::string, Stat> stats;
+  static auto last = std::chrono::steady_clock::now();
+  const std::string key = entry->absolute_path();
+  std::lock_guard lock(mutex);
+  Stat& s = stats[key];
+  if (s.reads++ == 0)
+    REXFS_INFO("HD read: first nonzero read of {} (backing {}): offset {} bytes {}", key,
+               entry->device() ? entry->device()->backing_path() : std::string(), offset, bytes);
+  s.bytes += bytes;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last >= std::chrono::seconds(10)) {
+    last = now;
+    for (const auto& [path, stat] : stats)
+      REXFS_INFO("HD read: {} reads {} bytes {}", path, stat.reads, stat.bytes);
+  }
+}
+}  // namespace

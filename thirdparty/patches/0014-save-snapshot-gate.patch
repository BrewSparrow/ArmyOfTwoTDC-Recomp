+/**
+ * AO2DC Save Manager: the save-write gate of the content manager (header only, no dependencies, so
+ * it can be tested on its own).
+ *
+ * Every operation that creates, opens, closes, deletes or writes the header or thumbnail of a save
+ * or profile package runs inside a SaveMutationScope. A snapshot (a consistent copy of the saves)
+ * can only begin when no such operation is running and no such package is open; from then until the
+ * owner releases it, new operations wait. The gate is never released by a timer: only End(token)
+ * with the owner's token does, and only one snapshot can exist at a time.
+ */
+
+#pragma once
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::system::xam {
+
+class SaveGate {
+ public:
+  // Start of a mutating operation. Waits while a snapshot is active unless `wait` is false (used for
+  // closing, which only needs to be counted).
+  void Enter(bool wait = true) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (wait) {
+      cv_.wait(lock, [this] { return !active_; });
+    }
+    ++operations_;
+  }
+
+  void Leave() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      --operations_;
+    }
+    cv_.notify_all();
+  }
+
+  // One attempt to begin a snapshot. `open_save_packages` is the number of save/profile packages
+  // open right now (read by the caller under the lock that guards the open list). Returns the
+  // owner token, or 0: not at a boundary yet (an operation or an open package), or, with
+  // *overlapped set, another snapshot is active.
+  uint64_t TryBegin(size_t open_save_packages, bool* overlapped = nullptr) {
+    if (overlapped) {
+      *overlapped = false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (active_) {
+      if (overlapped) {
+        *overlapped = true;
+      }
+      return 0;
+    }
+    if (operations_ != 0 || open_save_packages != 0) {
+      return 0;
+    }
+    active_ = true;
+    token_ = next_token_++;
+    return token_;
+  }
+
+  // Releases the gate for its owner. Anything else (wrong or stale token, no snapshot) changes
+  // nothing and returns false.
+  bool End(uint64_t token) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!active_ || token == 0 || token != token_) {
+        return false;
+      }
+      active_ = false;
+      token_ = 0;
+    }
+    cv_.notify_all();
+    return true;
+  }
+
+  bool active() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return active_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable cv_;
+  bool active_ = false;
+  uint64_t token_ = 0;
+  uint64_t next_token_ = 1;
+  size_t operations_ = 0;
+};
+
+// Counts one mutating operation for its lifetime (does nothing when `counted` is false, e.g. for
+// marketplace content, which snapshots do not cover).
+class SaveMutationScope {
+ public:
+  SaveMutationScope(SaveGate& gate, bool counted, bool wait = true) : gate_(counted ? &gate : nullptr) {
+    if (gate_) {
+      gate_->Enter(wait);
+    }
+  }
+  ~SaveMutationScope() {
+    if (gate_) {
+      gate_->Leave();
+    }
+  }
+  SaveMutationScope(const SaveMutationScope&) = delete;
+  SaveMutationScope& operator=(const SaveMutationScope&) = delete;
+
+ private:
+  SaveGate* gate_;
+};
+
+}  // namespace rex::system::xam

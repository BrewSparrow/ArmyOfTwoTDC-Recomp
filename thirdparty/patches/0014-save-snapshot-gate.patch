+size_t ContentManager::OpenSavePackageCountLocked() const {
+  size_t count = 0;
+  for (const auto& it : open_packages_) {
+    if (it.second->GetPackageContentData().content_type != XContentType::kMarketplaceContent) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+uint64_t ContentManager::BeginSaveSnapshot(std::chrono::milliseconds timeout, bool* overlapped) {
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  for (;;) {
+    {
+      // The open-package count is read under the lock that guards open_packages_; operations on
+      // packages are counted by the gate itself, so a package or operation is either seen here or
+      // waits on the gate.
+      auto global_lock = global_critical_region_.Acquire();
+      const uint64_t token = save_gate_.TryBegin(OpenSavePackageCountLocked(), overlapped);
+      if (token != 0 || (overlapped && *overlapped)) {
+        return token;
+      }
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      return 0;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+}
+
+bool ContentManager::EndSaveSnapshot(uint64_t token) {
+  return save_gate_.End(token);
+}

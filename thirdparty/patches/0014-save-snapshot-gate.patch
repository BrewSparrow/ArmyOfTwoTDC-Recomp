+void ContentManager::WaitForSaveSnapshot(XContentType content_type) {
+  if (content_type == XContentType::kMarketplaceContent) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(snapshot_mutex_);
+  snapshot_cv_.wait(lock, [this] { return !snapshot_active_; });
+}
+
+size_t ContentManager::OpenSavePackageCountLocked() const {
+  size_t count = 0;
+  for (const auto& it : open_packages_) {
+    if (it.second->GetPackageContentData().content_type != XContentType::kMarketplaceContent) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+bool ContentManager::BeginSaveSnapshot(std::chrono::milliseconds timeout) {
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  for (;;) {
+    {
+      // The check and the flag are one step under the same lock that guards open_packages_, so a
+      // package is either already counted here or sees the flag when it tries to open.
+      auto global_lock = global_critical_region_.Acquire();
+      if (OpenSavePackageCountLocked() == 0) {
+        std::lock_guard<std::mutex> lock(snapshot_mutex_);
+        snapshot_active_ = true;
+        return true;
+      }
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+}
+
+void ContentManager::EndSaveSnapshot() {
+  {
+    std::lock_guard<std::mutex> lock(snapshot_mutex_);
+    snapshot_active_ = false;
+  }
+  snapshot_cv_.notify_all();
+}

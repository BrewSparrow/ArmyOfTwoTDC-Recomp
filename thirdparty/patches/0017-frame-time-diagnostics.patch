+// AO2DC diagnostics: when the guest called VdSwap for each of the last 256 swaps (microseconds, steady
+// clock), so the command processor can tell a frame the game finished late from one the GPU thread
+// processed late. Written by the guest thread, read by the command processor (relaxed).
+static std::atomic<uint64_t> ao2dc_guest_swap_time_us[256];
+uint64_t Ao2dcGuestSwapTimeUs(uint64_t swap_number) {
+  return ao2dc_guest_swap_time_us[swap_number & 255].load(std::memory_order_relaxed);

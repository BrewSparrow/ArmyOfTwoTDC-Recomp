+// Backslashes and quotes must be escaped, or a saved Windows path makes the file unreadable.
+static std::string EscapeTomlString(const std::string& value) {
+  std::string out;
+  for (char c : value) {
+    if (c == '\\' || c == '"')
+      out += '\\';
+    out += c;
+  }
+  return out;
+}
